# --- Next.js / Web ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PI_SANDBOX=true

# --- Pi Network ---
# Get these from https://developers.minepi.com after registering an app.
PI_API_KEY=replace-with-server-side-api-key
PI_PLATFORM_API_URL=https://api.minepi.com/v2

# --- iron-session ---
# 32+ random characters; generate with: openssl rand -hex 32
SESSION_PASSWORD=change-me-to-a-32-plus-char-random-string
SESSION_COOKIE_NAME=pi_animals_session

# --- Database (Postgres) ---
DATABASE_URL=postgresql://pianimals:pianimals@localhost:5432/pianimals?schema=public

# --- Upstash Redis (rate limit + queue) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Polygon / Contracts ---
POLYGON_RPC_URL=https://polygon-rpc.com
MUMBAI_RPC_URL=https://rpc-amoy.polygon.technology
DEPLOYER_PRIVATE_KEY=
POLYGONSCAN_API_KEY=
PIPET_DOG_CONTRACT=
PIPET_CAT_CONTRACT=

# --- IPFS ---
PINATA_JWT=
NFT_STORAGE_TOKEN=

# --- Observability ---
SENTRY_DSN=
